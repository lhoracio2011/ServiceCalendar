<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: no app data is copied to Google cloud backup or by device-to-device transfer
  (allowBackup="false" alone does not disable device transfer). The only restore path is the
  app's own Google Drive backup, so a copied database could not get out of sync with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
